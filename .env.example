### Ppokket backend — environment variables reference.
### Copy to `.env` and fill in real values. Never commit the real `.env`.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://ppokket.com
ALLOWED_ORIGINS=https://ppokket.com,https://www.ppokket.com,https://admin.ppokket.com

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ppokket_db

# Let the server add, at start-up, the few columns / ENUM values newer code
# needs (utils/schemaUpgrades.js) instead of running the config/migration_*.sql
# files by hand. It only ever adds — nothing is dropped or emptied. Leave unset
# to keep schema changes manual.
# AUTO_SCHEMA_UPGRADE=true

# ── Redis (cache) ────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Firebase Admin (push notifications) ─────────────────────────────────────
# FIREBASE_PRIVATE_KEY must keep its \n line breaks (quote the whole value).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cashfree (payments + Auto-Pay mandates) ─────────────────────────────────
# Leave unset / placeholder to run in mock mode locally. Must be real values
# in production — mock mode logs a loud warning if it activates there.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree dashboard → Developers → Webhooks: point BOTH the Payment Gateway
# webhook and the Subscriptions webhook at   <api>/api/payment/webhook
# (subscription events: status changed, auth status, payment success / failed /
# cancelled). They are verified with CASHFREE_SECRET_KEY — no extra secret.
#
# Auto-Pay (EMI auto-debit through a Cashfree subscription):
#   production      always goes through Cashfree; refused if the keys above are missing.
#   anywhere else   simulated, unless AUTOPAY_USE_GATEWAY=true — then it uses the
#                   Cashfree environment above (sandbox), to test the real flow.
# AUTOPAY_USE_GATEWAY=true
#
# Auto-Pay in TEST MODE while payments stay live. Use it for as long as the
# live Cashfree account's Subscriptions product is not activated (setting up
# Auto-Pay then fails with "Profile is inactive"). Give Auto-Pay the TEST key
# pair from the Cashfree dashboard (Test mode → Developers → API keys):
#   - customers authorise the mandate on Cashfree's test page;
#   - EMIs are raised and marked paid on their due date exactly as with a real
#     mandate, but NO MONEY IS DEBITED — each one is marked "[TEST]" in
#     Transactions, and Admin → Settings → Payment Gateway shows "Test mode".
# When Cashfree activates Subscriptions on the live account, delete these three
# lines and restart; customers then set up Auto-Pay once more, for real.
# AUTOPAY_CASHFREE_ENV=sandbox
# AUTOPAY_CASHFREE_APP_ID=
# AUTOPAY_CASHFREE_SECRET_KEY=
#
# Largest single debit a new mandate allows (the customer sees it when
# authorising). EMIs above it can't be auto-debited. Default 50000.
# AUTOPAY_MAX_AMOUNT=50000

# ── Razorpay (one-time payments; alternative to Cashfree) ───────────────────
# Which gateway collects payments is chosen in Admin → Settings → Payment
# Gateway. The switch to Razorpay is refused until these are real keys.
# Auto-Pay mandates always stay on Cashfree.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
# Secret of the webhook added on the Razorpay dashboard, pointing at
#   <api>/api/payment/webhook/razorpay   (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
# Public base URL of this API, used for the Razorpay return link the app is
# sent back through and the link Cashfree returns to after Auto-Pay
# authorisation. Optional — defaults to the host the request came in on.
# API_PUBLIC_URL=https://api.ppokket.com

# ── Cloudinary (KYC document storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (email — loan agreements, notifications) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── FTP (used by a specific upload/export flow — see FTP_ROOT_URL usage) ────
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_UPLOAD_DIR=
FTP_ROOT_URL=

# ── Third-party verification & SMS APIs ──────────────────────────────────────
ORBITEL_USER=
ORBITEL_AUTHKEY=
ORBITEL_SENDER=
ORBITEL_TEMPLATE_ID=
# Reference-number OTP: its own DLT template. Both set = used; otherwise the login template.
# The text exactly as approved, with {name} (customer's name) and {otp} in place of its {#var#}.
# Invisible characters as \uXXXX: the current template needs ​ before each variable.
ORBITEL_REFERENCE_TEMPLATE_ID=
ORBITEL_REFERENCE_SMS=
INSIGHT_API_TOKEN=
# APItxt: IFSC branch lookup (always), and PAN / Aadhaar / bank when KYC_PROVIDER is not quickekyc
APITXT_AUTHKEY=

# KYC checks through QuickeKYC — PAN, Aadhaar OTP, bank account, GST number.
# KYC_PROVIDER=quickekyc turns it on; leave it empty to stay on APItxt.
KYC_PROVIDER=
QUICKEKYC_API_KEY=
# https://api.quickekyc.com (live, default) or https://sandbox.quickekyc.com (its own key)
QUICKEKYC_BASE_URL=https://api.quickekyc.com

# ── Development / Testing ───────────────────────────────────────────────────
DEV_TEST_MOBILE=
DEV_TEST_OTP=

# ── Destructive script safety (backend/config/reset-db.js) ──────────────────
# Only needed if you must run reset-db against NODE_ENV=production. Must
# exactly equal "RESET <DB_NAME>" — see reset-db.js for the guard.
CONFIRM_PRODUCTION_RESET=

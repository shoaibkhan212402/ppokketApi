### Ppokket backend — environment variables reference.
### Copy to `.env` and fill in real values. Never commit the real `.env`.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://ppokket.com
ALLOWED_ORIGINS=https://ppokket.com,https://www.ppokket.com,https://admin.ppokket.com

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ppokket_db

# ── Redis (cache) ────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Firebase Admin (push notifications) ─────────────────────────────────────
# FIREBASE_PRIVATE_KEY must keep its \n line breaks (quote the whole value).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cashfree (payments + Auto-Pay mandates) ─────────────────────────────────
# Leave unset / placeholder to run in mock mode locally. Must be real values
# in production — mock mode logs a loud warning if it activates there.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox

# ── Cloudinary (KYC document storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (email — loan agreements, notifications) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── FTP (used by a specific upload/export flow — see FTP_ROOT_URL usage) ────
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_UPLOAD_DIR=
FTP_ROOT_URL=

# ── Third-party verification & SMS APIs ──────────────────────────────────────
ORBITEL_USER=
ORBITEL_AUTHKEY=
ORBITEL_SENDER=
ORBITEL_TEMPLATE_ID=
INSIGHT_API_TOKEN=

# ── Development / Testing ───────────────────────────────────────────────────
DEV_TEST_MOBILE=
DEV_TEST_OTP=

# ── Destructive script safety (backend/config/reset-db.js) ──────────────────
# Only needed if you must run reset-db against NODE_ENV=production. Must
# exactly equal "RESET <DB_NAME>" — see reset-db.js for the guard.
CONFIRM_PRODUCTION_RESET=

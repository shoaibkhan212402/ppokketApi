### Ppokket backend — environment variables reference.
### Copy to `.env` and fill in real values. Never commit the real `.env`.

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
FRONTEND_URL=https://ppokket.com
ALLOWED_ORIGINS=https://ppokket.com,https://www.ppokket.com,https://admin.ppokket.com

# ── Database (MySQL) ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ppokket_db

# ── Redis (cache) ────────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=

# ── Firebase Admin (push notifications) ─────────────────────────────────────
# FIREBASE_PRIVATE_KEY must keep its \n line breaks (quote the whole value).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Cashfree (payments + Auto-Pay mandates) ─────────────────────────────────
# Leave unset / placeholder to run in mock mode locally. Must be real values
# in production — mock mode logs a loud warning if it activates there.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
# Cashfree dashboard → Developers → Webhooks: point BOTH the Payment Gateway
# webhook and the Subscriptions webhook at   <api>/api/payment/webhook
# (subscription events: status changed, auth status, payment success / failed /
# cancelled). They are verified with CASHFREE_SECRET_KEY — no extra secret.
#
# Auto-Pay (EMI auto-debit through a Cashfree subscription):
#   production      always goes through Cashfree; refused if the keys above are missing.
#   anywhere else   simulated, unless AUTOPAY_USE_GATEWAY=true — then it uses the
#                   Cashfree environment above (sandbox), to test the real flow.
# AUTOPAY_USE_GATEWAY=true
# Largest single debit a new mandate allows (the customer sees it when
# authorising). EMIs above it can't be auto-debited. Default 50000.
# AUTOPAY_MAX_AMOUNT=50000

# ── Razorpay (one-time payments; alternative to Cashfree) ───────────────────
# Which gateway collects payments is chosen in Admin → Settings → Payment
# Gateway. The switch to Razorpay is refused until these are real keys.
# Auto-Pay mandates always stay on Cashfree.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
# Secret of the webhook added on the Razorpay dashboard, pointing at
#   <api>/api/payment/webhook/razorpay   (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret
# Public base URL of this API, used for the Razorpay return link the app is
# sent back through and the link Cashfree returns to after Auto-Pay
# authorisation. Optional — defaults to the host the request came in on.
# API_PUBLIC_URL=https://api.ppokket.com

# ── Cloudinary (KYC document storage) ────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (email — loan agreements, notifications) ───────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── FTP (used by a specific upload/export flow — see FTP_ROOT_URL usage) ────
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_UPLOAD_DIR=
FTP_ROOT_URL=

# ── Third-party verification & SMS APIs ──────────────────────────────────────
ORBITEL_USER=
ORBITEL_AUTHKEY=
ORBITEL_SENDER=
ORBITEL_TEMPLATE_ID=
INSIGHT_API_TOKEN=

# ── Development / Testing ───────────────────────────────────────────────────
DEV_TEST_MOBILE=
DEV_TEST_OTP=

# ── Destructive script safety (backend/config/reset-db.js) ──────────────────
# Only needed if you must run reset-db against NODE_ENV=production. Must
# exactly equal "RESET <DB_NAME>" — see reset-db.js for the guard.
CONFIRM_PRODUCTION_RESET=
